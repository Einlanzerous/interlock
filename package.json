{
  "name": "interlock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun run --filter '@interlock/*' dev",
    "build": "bun run --filter '@interlock/web' build",
    "start:worker": "bun run --filter '@interlock/worker' start",
    "db:migrate": "bun run --filter '@interlock/db' migrate",
    "auth:hash": "bun scripts/hash-password.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p packages/db/tsconfig.json && tsc -p packages/worker/tsconfig.json && bun run --filter '@interlock/web' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "overrides": {
    "tar": "^7.5.22",
    "vite": "^7.3.7",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.7",
    "baseline-browser-mapping": "^2.11.32",
    "serialize-javascript": "^7.1.4",
    "shell-quote": "^1.12.0",
    "svgo": "^4.1.0",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.31",
    "browserslist": "^4.29.4",
    "brace-expansion": "^5.0.12",
    "minimatch": "^10.2.5"
  },
  "dependencies": {
    "brace-expansion": "^5.0.12"
  }
}
